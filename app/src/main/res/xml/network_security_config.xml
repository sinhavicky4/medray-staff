<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows cleartext (plain HTTP) traffic to 10.0.2.2 only — the Android
  emulator's alias for the host machine's localhost, where api/ runs during
  local dev (npm run dev, port 4000). API 28+ blocks cleartext by default.
  A real deployment must use HTTPS and this domain-specific carve-out should
  be removed, not widened.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
